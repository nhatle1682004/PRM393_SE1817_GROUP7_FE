{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "waste-reports": {
        "ClusterId": "waste",
        "Match": { "Path": "/api/waste-reports/{**catch-all}" }
      },
      "waste-types": {
        "ClusterId": "waste",
        "Match": { "Path": "/api/waste-types/{**catch-all}" }
      },
      "districts": {
        "ClusterId": "waste",
        "Match": { "Path": "/api/districts/{**catch-all}" }
      },
      "collection-requests": {
        "ClusterId": "collection",
        "Match": { "Path": "/api/collection-requests/{**catch-all}" }
      },
      "assignments": {
        "ClusterId": "collection",
        "Match": { "Path": "/api/assignments/{**catch-all}" }
      },
      "enterprise": {
        "ClusterId": "collection",
        "Match": { "Path": "/api/enterprise/{**catch-all}" }
      },
      "collections": {
        "ClusterId": "collection",
        "Match": { "Path": "/api/collections/{**catch-all}" }
      },
      "notifications": {
        "ClusterId": "engagement",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "rewards": {
        "ClusterId": "engagement",
        "Match": { "Path": "/api/rewards/{**catch-all}" }
      },
      "feedbacks": {
        "ClusterId": "engagement",
        "Match": { "Path": "/api/feedbacks/{**catch-all}" }
      },
      "dashboard": {
        "ClusterId": "engagement",
        "Match": { "Path": "/api/dashboard/{**catch-all}" }
      },
      "waste-report-files": {
        "ClusterId": "waste",
        "Match": { "Path": "/uploads/waste-reports/{**catch-all}" }
      },
      "collection-proof-files": {
        "ClusterId": "collection",
        "Match": { "Path": "/uploads/collection-proofs/{**catch-all}" }
      },
      "collection-issue-files": {
        "ClusterId": "collection",
        "Match": { "Path": "/uploads/issue-proofs/{**catch-all}" }
      },
      "feedback-files": {
        "ClusterId": "engagement",
        "Match": { "Path": "/uploads/feedbacks/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity-1": { "Address": "http://localhost:5292/" }
        }
      },
      "waste": {
        "Destinations": {
          "waste-1": { "Address": "http://localhost:5037/" }
        }
      },
      "collection": {
        "Destinations": {
          "collection-1": { "Address": "http://localhost:5166/" }
        }
      },
      "engagement": {
        "Destinations": {
          "engagement-1": { "Address": "http://localhost:5200/" }
        }
      }
    }
  }
}
